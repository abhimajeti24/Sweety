# Copy this file to .env and adjust. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
DATABASE_URL_TEST=postgres://sweety:sweety@localhost:5432/sweety_test

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Optional: Redis cache + BullMQ jobs (leave empty to disable both)
REDIS_URL=
REDIS_URL_TEST=
REPORT_CACHE_TTL_SECONDS=300
REMINDER_CRON=0 20 * * *

# Docker Compose (database container)
POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety

# Client
VITE_API_BASE_URL=/api
