{
  "name": "@sweety/server",
  "version": "1.0.0",
  "private": true,
  "description": "Sweety REST API: Express 5 + PostgreSQL.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../shared/src src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/reset.js && node src/db/seed.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@sweety/shared": "^1.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
